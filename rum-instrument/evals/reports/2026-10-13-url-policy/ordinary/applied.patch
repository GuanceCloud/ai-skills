--- /dev/null
+++ b/scripts/build.mjs
@@ -0,0 +1,8 @@
+import { build } from 'esbuild';
+import { mkdir, copyFile } from 'node:fs/promises';
+await build({ entryPoints: ['src/bootstrap.js'], bundle: true, splitting: true,
+  format: 'esm', outdir: 'dist/src', target: 'es2022' });
+await mkdir('dist', { recursive: true });
+for (const file of ['index.html', 'rum-config.js']) {
+  await copyFile(file, `dist/${file}`);
+}
