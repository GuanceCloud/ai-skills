diff --git a/scripts/build-rum.sh b/scripts/build-rum.sh
new file mode 100755
index 0000000..a62a1a7
--- /dev/null
+++ b/scripts/build-rum.sh
@@ -0,0 +1,10 @@
+#!/bin/sh
+set -eu
+cd "$(dirname "$0")/.."
+case "${1:-}" in
+    PhoneApp) sdk=iphonesimulator ;;
+    TVApp) sdk=appletvsimulator ;;
+    *) echo "Usage: $0 PhoneApp|TVApp" >&2; exit 2 ;;
+esac
+# Run pod install first after restoring the complete Xcode project.
+exec xcodebuild -workspace App.xcworkspace -scheme "$1" -configuration Debug     -sdk "$sdk" -xcconfig "Config/RUM-$1.xcconfig" CODE_SIGNING_ALLOWED=NO build
