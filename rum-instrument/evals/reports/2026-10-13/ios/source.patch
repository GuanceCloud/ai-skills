diff --git a/Sources/AppDelegate.swift b/Sources/AppDelegate.swift
index b372700..2acb846 100644
--- a/Sources/AppDelegate.swift
+++ b/Sources/AppDelegate.swift
@@ -1,3 +1,48 @@
 import UIKit
+import GuanceSDK
 
-final class AppDelegate: UIResponder, UIApplicationDelegate {}
+final class AppDelegate: UIResponder, UIApplicationDelegate {
+    func application(
+        _ application: UIApplication,
+        didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]? = nil
+    ) -> Bool {
+        RumBootstrap.start()
+        return true
+    }
+}
+
+private enum RumBootstrap {
+    private static var started = false
+
+    static func start() {
+        guard !started else { return }
+        let info = Bundle.main.infoDictionary ?? [:]
+        func value(_ key: String) -> String? {
+            guard let text = info[key] as? String,
+                  !text.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty,
+                  !text.contains("$(") else { return nil }
+            return text
+        }
+        guard let endpoint = value("RUM_DATAKIT_URL"),
+              let url = URL(string: endpoint),
+              ["http", "https"].contains(url.scheme ?? ""),
+              url.host != nil,
+              let appID = value("RUM_APP_ID"),
+              let environment = value("RUM_ENV") else {
+            NSLog("RUM configuration missing or invalid; monitoring is disabled")
+            return
+        }
+        let config = FTSDKConfig(datakitUrl: endpoint)
+        config.env = environment
+        config.service = Bundle.main.bundleIdentifier ?? "apple-app"
+        FTSDKAgent.start(withConfigOptions: config)
+        let rum = FTRumConfig(appid: appID)
+        rum.enableTraceUserView = true
+        rum.enableTraceWebView = false
+        rum.enableTrackAppCrash = false
+        rum.enableTrackAppANR = false
+        rum.enableTrackAppFreeze = false
+        FTSDKAgent.sharedInstance().startRum(withConfigOptions: rum)
+        started = true
+    }
+}
