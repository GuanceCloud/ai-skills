diff --git a/app/src/main/java/com/example/rum/App.kt b/app/src/main/java/com/example/rum/App.kt
index d7e61b6..92c56eb 100644
--- a/app/src/main/java/com/example/rum/App.kt
+++ b/app/src/main/java/com/example/rum/App.kt
@@ -1,5 +1,36 @@
 package com.example.rum
 
 import android.app.Application
+import android.util.Log
+import com.ft.sdk.FTRUMConfig
+import com.ft.sdk.FTSDKConfig
+import com.ft.sdk.FTSdk
 
-class App : Application()
+class App : Application() {
+    override fun onCreate() {
+        super.onCreate()
+        if (BuildConfig.RUM_DATAKIT_URL.isBlank() || BuildConfig.RUM_APP_ID.isBlank() ||
+            BuildConfig.RUM_ENV.isBlank()) {
+            Log.w("RUM", "RUM configuration missing; monitoring is disabled")
+            return
+        }
+        try {
+            val config = FTSDKConfig.builder(BuildConfig.RUM_DATAKIT_URL)
+                .setServiceName(packageName)
+                .setEnv(BuildConfig.RUM_ENV)
+                .setEnableAccessAndroidID(false)
+            FTSdk.install(config)
+            FTSdk.initRUMWithConfig(
+                FTRUMConfig()
+                    .setRumAppId(BuildConfig.RUM_APP_ID)
+                    .setEnableTraceUserView(true)
+                    .setEnableTraceWebView(false)
+                    .setEnableTrackAppCrash(false)
+                    .setEnableTrackAppANR(false)
+                    .setEnableTrackAppUIBlock(false)
+            )
+        } catch (error: Exception) {
+            Log.w("RUM", "RUM initialization failed; application startup continues")
+        }
+    }
+}
