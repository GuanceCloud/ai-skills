diff --git a/app/build.gradle.kts b/app/build.gradle.kts
index 8a29c97..ee82ec4 100644
--- a/app/build.gradle.kts
+++ b/app/build.gradle.kts
@@ -1,7 +1,35 @@
+import java.util.Properties
+
 plugins {
     id("com.android.application")
 }
 
+val rumProperties = Properties().apply {
+    val config = rootProject.file("rum.properties")
+    if (config.isFile) config.inputStream().use { load(it) }
+}
+fun rumValue(name: String): String = providers.gradleProperty(name)
+    .orElse(providers.environmentVariable(name)).orNull
+    ?: rumProperties.getProperty(name, "")
+fun quoted(value: String) = "\"" + value.replace("\\", "\\\\").replace("\"", "\\\"")
+    .replace("\n", "\\n").replace("\r", "\\r") + "\""
+
 android {
     namespace = "com.example.rum"
+    buildFeatures { buildConfig = true }
+    defaultConfig {
+        for (key in listOf("RUM_DATAKIT_URL", "RUM_APP_ID", "RUM_ENV")) {
+            buildConfigField("String", key, quoted(rumValue(key)))
+        }
+    }
+}
+
+repositories {
+    mavenCentral()
+    maven { url = uri("https://mvnrepo.guance.com/repository/maven-releases") }
+}
+
+dependencies {
+    implementation("com.cloudcare.ft.mobile.sdk.tracker.agent:ft-sdk:1.7.5")
+    implementation("com.google.code.gson:gson:2.8.9")
 }
