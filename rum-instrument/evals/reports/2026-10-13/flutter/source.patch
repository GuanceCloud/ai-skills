diff --git a/lib/rum_mobile.dart b/lib/rum_mobile.dart
new file mode 100644
index 0000000..95bea83
--- /dev/null
+++ b/lib/rum_mobile.dart
@@ -0,0 +1,76 @@
+import 'dart:io';
+import 'dart:ui';
+import 'package:flutter/foundation.dart';
+import 'package:flutter/widgets.dart';
+import 'package:ft_mobile_agent_flutter/ft_mobile_agent_flutter.dart';
+
+Future<void>? _initialization;
+
+Future<void> initializeRum() => _initialization ??= _initialize();
+
+Future<void> _initialize() async {
+  if (!Platform.isAndroid && !Platform.isIOS) return;
+  const receiver = String.fromEnvironment('RUM_DATAKIT_URL');
+  const androidId = String.fromEnvironment('RUM_ANDROID_APP_ID');
+  const iosId = String.fromEnvironment('RUM_IOS_APP_ID');
+  const environment = String.fromEnvironment('RUM_ENV', defaultValue: 'unspecified');
+  if (receiver.isEmpty || (Platform.isAndroid ? androidId : iosId).isEmpty) {
+    debugPrint('[RUM] Missing build configuration; monitoring is disabled.');
+    return;
+  }
+  try {
+    await FTMobileFlutter.sdkConfig(
+      datakitUrl: receiver,
+      serviceName: 'rum_eval_mobile',
+      env: environment.isEmpty ? 'unspecified' : environment,
+      enableAccessAndroidID: false,
+      enableRemoteConfiguration: false,
+    );
+    await FTRUMManager().setConfig(
+      androidAppId: androidId,
+      iOSAppId: iosId,
+      enableNativeUserAction: false,
+      enableNativeUserView: false,
+      enableNativeUserResource: false,
+      // No HTTP client exists in this skeleton. The SDK captures headers/body
+      // when automatic resource instrumentation is enabled; keep it off until
+      // a concrete client can be instrumented with reviewed data filtering.
+      enableUserResource: false,
+      enableTrackNativeCrash: false,
+      enableTrackNativeAppANR: false,
+      enableNativeAppUIBlock: false,
+      enableTraceWebView: false,
+    );
+    final previousFlutterError = FlutterError.onError;
+    FlutterError.onError = (details) {
+      _reportError(details.exception, details.stack ?? StackTrace.empty);
+      previousFlutterError?.call(details);
+    };
+    final previousPlatformError = PlatformDispatcher.instance.onError;
+    PlatformDispatcher.instance.onError = (error, stack) {
+      _reportError(error, stack);
+      return previousPlatformError?.call(error, stack) ?? false;
+    };
+    await FTRUMManager().starView('app-root');
+    WidgetsBinding.instance.addObserver(_RootViewObserver());
+  } catch (_) {
+    debugPrint('[RUM] Initialization failed; application startup continues.');
+  }
+}
+
+void _reportError(Object error, StackTrace stack) {
+  // Do not capture arbitrary error message values or application objects.
+  FTRUMManager().addCustomError(stack.toString(), error.runtimeType.toString())
+      .catchError((Object _) {});
+}
+
+class _RootViewObserver extends WidgetsBindingObserver {
+  @override
+  void didChangeAppLifecycleState(AppLifecycleState state) {
+    if (state == AppLifecycleState.resumed) {
+      FTRUMManager().starView('app-root').catchError((Object _) {});
+    } else if (state == AppLifecycleState.paused) {
+      FTRUMManager().stopView().catchError((Object _) {});
+    }
+  }
+}
