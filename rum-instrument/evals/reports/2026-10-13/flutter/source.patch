diff --git a/web/rum.js b/web/rum.js
new file mode 100644
index 0000000..ee71b66
--- /dev/null
+++ b/web/rum.js
@@ -0,0 +1,37 @@
+(function () {
+  if (window.__flutterRumInitialized) return;
+  try {
+    var config = window.RUM_CONFIG;
+    if (!config || !config.applicationId || !config.datakitOrigin || !window.DATAFLUX_RUM) {
+      throw new Error('RUM configuration or SDK unavailable');
+    }
+    window.DATAFLUX_RUM.init({
+      applicationId: config.applicationId,
+      datakitOrigin: config.datakitOrigin,
+      service: config.service,
+      version: config.version || undefined,
+      env: config.env || undefined,
+      trackUserInteractions: true,
+      allowedTracingUrls: [],
+      sessionReplaySampleRate: 0,
+      sessionReplayOnErrorSampleRate: 0,
+      beforeSend: function (event) {
+        [event.view, event.resource].forEach(function (part) {
+          if (!part) return;
+          ['url', 'referrer'].forEach(function (field) {
+            if (typeof part[field] === 'string') {
+              try {
+                var url = new URL(part[field], window.location.origin);
+                url.search = ''; url.hash = ''; url.username = ''; url.password = '';
+                part[field] = url.toString();
+              } catch (_) { delete part[field]; }
+            }
+          });
+        });
+      },
+    });
+    window.__flutterRumInitialized = true;
+  } catch (_) {
+    console.warn('[RUM] Initialization unavailable; Flutter startup continues.');
+  }
+})();
